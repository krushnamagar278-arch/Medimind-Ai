# ==============================================================================
# MediMind AI - Root .gitignore
# ==============================================================================

# Environment & Secret Files (CRITICAL: Never commit credentials to GitHub)
*.env
*.env.*
!.env.example
!backend/.env.example
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
env.bak/
venv.bak/

# SQLite & Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-journal

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
