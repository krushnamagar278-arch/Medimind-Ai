# ==============================================================================
# MEDIMIND AI - Environment Configuration Template
# Duplicate this file as `.env` inside the `backend/` directory and populate your keys.
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="MEDIMIND AI Backend"
API_PREFIX=/api/v1

# Local Database (SQLite via aiosqlite)
DATABASE_URL="sqlite+aiosqlite:///./medimind.db"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Google Gemini API Key (Required for vision OCR and clinical agents)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# openFDA API Key (Optional: increases rate limits for drug label queries)
# Register at: https://open.fda.gov/apis/authentication/
OPENFDI_API_KEY="your_openfda_api_key_here_optional"

